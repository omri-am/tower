#!/usr/bin/env bash
set -euo pipefail

[ $# -eq 0 ] || { echo 'usage: tower-territories (no arguments)' >&2; exit 1; }
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOCATED="$("$BIN_DIR/tower-locate")" || exit $?
PROJECT_DIR="$(printf '%s\n' "$LOCATED" | sed -n 1p)"
. "$BIN_DIR/../lib/tower-paths.sh"
. "$BIN_DIR/../lib/tower-dispatch.sh"

# validate_ownership_paths reports through dispatch_die; return its message as a charter problem.
dispatch_die() { printf '%s\n' "$*"; exit 1; }

field() {
  awk -v key="$2" '
    /^---$/ {delimiters++; next}
    delimiters==1 && index($0,key ":")==1 {
      value=substr($0,length(key)+2)
      gsub(/^[[:space:]"]+|[[:space:]"]+$/, "", value)
      print value
      exit
    }
  ' "$1"
}

charter_paths() {
  awk '
    /^## Paths/ {inside=1; next}
    /^## / {inside=0}
    inside && /^- / {
      path=$2
      gsub(/`/, "", path)
      sub(/^\.\//, "", path)
      print path
    }
  ' "$1"
}

unknown_fields() {
  awk '
    /^---$/ {delimiters++; next}
    delimiters==1 && NF {
      key=$0
      sub(/:.*/, "", key)
      if (key!="name" && key!="role" && key!="approval") print key
    }
  ' "$1"
}

problem() {
  printf 'tower-territories: %s: %s\n' "$1" "$2" >&2
  RESULT=1
}

CHARTER_FILES=()
CHARTER_NAMES=()
CHARTER_PATHS=()
PATH_OWNERS=()
RESULT=0
export LC_ALL=C # Keep glob, regex, and sort order stable.

check_charter() {
  local file="$1" stem rel owner name role approval unknown paths key charter_path message
  stem="${file##*/}"
  stem="${stem%.md}"
  rel=".tower/territories/${file##*/}"
  CHARTER_FILES+=("$rel")
  CHARTER_NAMES+=("$stem")
  owner=$((${#CHARTER_FILES[@]} - 1))
  if ! [[ "$stem" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    problem "$rel" "charter name '$stem' must match [a-z0-9][a-z0-9-]*"
  fi
  name="$(field "$file" name)"
  [ "$name" = "$stem" ] || problem "$rel" "name '$name' must equal the file stem '$stem'"
  role="$(field "$file" role)"
  case "$role" in
    ''|.|..|*/*|*\\*) problem "$rel" "role '$role' must be nonempty, not . or .., and contain no / or \\" ;;
  esac
  approval="$(field "$file" approval)"
  case "$approval" in
    '') problem "$rel" 'approval is missing; use owner or delegated' ;;
    owner|delegated) ;;
    *) problem "$rel" "approval '$approval' must be owner or delegated" ;;
  esac
  unknown="$(unknown_fields "$file")"
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    problem "$rel" "unknown frontmatter field '$key'"
  done <<< "$unknown"
  paths="$(charter_paths "$file")"
  [ -n "$paths" ] || problem "$rel" '## Paths lists no path'
  while IFS= read -r charter_path; do
    [ -n "$charter_path" ] || continue
    CHARTER_PATHS+=("$charter_path")
    PATH_OWNERS+=("$owner")
    if ! message="$(validate_ownership_paths "$charter_path")"; then
      problem "$rel" "$message"
    fi
  done <<< "$paths"
}

for FILE in "$PROJECT_DIR"/.tower/territories/*.md; do
  [ -f "$FILE" ] || continue
  check_charter "$FILE"
done

check_disjoint() {
  local left right
  for ((left=0; left<${#CHARTER_PATHS[@]}; left++)); do
    for ((right=left+1; right<${#CHARTER_PATHS[@]}; right++)); do
      [ "${PATH_OWNERS[left]}" != "${PATH_OWNERS[right]}" ] || continue
      if tower_paths_overlap "${CHARTER_PATHS[left]}" "${CHARTER_PATHS[right]}"; then
        problem "${CHARTER_FILES[${PATH_OWNERS[left]}]}" "path ${CHARTER_PATHS[left]} overlaps ${CHARTER_FILES[${PATH_OWNERS[right]}]} path ${CHARTER_PATHS[right]}"
      fi
    done
  done
}

check_disjoint

path_territory() {
  local path="$1" index found=""
  for ((index=0; index<${#CHARTER_PATHS[@]}; index++)); do
    tower_path_within "$path" "${CHARTER_PATHS[index]}" || continue
    [ -z "$found" ] || [ "$found" = "${PATH_OWNERS[index]}" ] || return 1
    found="${PATH_OWNERS[index]}"
  done
  [ -n "$found" ] || return 1
  printf '%s\n' "$found"
}

card_territory() {
  local card="$1" id="$2" owned path owner territory=""
  owned="$(tower_owned_paths "$card")"
  while IFS= read -r path; do
    case "$path" in
      ''|"changelog.d/$id.md"|"protocol.d/$id.md"|"reference.d/$id.md") continue ;;
    esac
    owner="$(path_territory "$path")" || { echo main; return 0; }
    [ -z "$territory" ] || [ "$territory" = "$owner" ] || { echo main; return 0; }
    territory="$owner"
  done <<< "$owned"
  if [ -n "$territory" ]; then echo "${CHARTER_NAMES[territory]}"; else echo main; fi
}

for CARD in "$PROJECT_DIR"/.tower/tasks/*.md; do
  [ -f "$CARD" ] || continue
  ID="$(field "$CARD" id)"
  printf '%s\t%s\t%s\n' "$ID" "$(card_territory "$CARD" "$ID")" "$(field "$CARD" status)"
done | sort
exit "$RESULT"
