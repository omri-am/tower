#!/usr/bin/env bash
set -euo pipefail
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1 || { echo 'tower-ui: Python 3.9+ is required for the optional browser workspace' >&2; exit 1; }
export PYTHONDONTWRITEBYTECODE=1
exec python3 "$BIN_DIR/../lib/tower_ui_server.py" "$@"
