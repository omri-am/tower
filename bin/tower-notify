#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 2 ]; then
  echo "usage: tower-notify <title> <message>" >&2
  exit 1
fi

TITLE="tower: $1"
MESSAGE="$2"
if [ -n "${TOWER_NOTIFY_COMMAND:-}" ]; then
  "$TOWER_NOTIFY_COMMAND" "$TITLE" "$MESSAGE"
elif command -v osascript >/dev/null; then
  osascript -e "display notification \"${MESSAGE//\"/\\\"}\" with title \"${TITLE//\"/\\\"}\" sound name \"Glass\""
elif command -v notify-send >/dev/null && { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
  notify-send "$TITLE" "$MESSAGE"
else
  printf '%s: %s\a\n' "$TITLE" "$MESSAGE" >&2
fi
