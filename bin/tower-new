#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo 'usage: tower-new [--track <name>] <title> (one nonempty, quoted argument)' >&2
  exit 1
}

TITLE=''
TITLE_SET=0
TRACK=''
TRACK_SET=0
while [ $# -gt 0 ]; do
  case "$1" in
    --track)
      [ "$TRACK_SET" -eq 0 ] && [ $# -ge 2 ] || usage
      shift
      [[ "$1" != -* ]] || usage
      TRACK="$1"
      TRACK_SET=1 ;;
    -*) usage ;;
    *)
      [ "$TITLE_SET" -eq 0 ] || usage
      TITLE="$1"
      TITLE_SET=1 ;;
  esac
  shift
done
[ "$TITLE_SET" -eq 1 ] && [ -n "$TITLE" ] || usage
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOCATED="$("$BIN_DIR/tower-locate")" || exit $?
PROJECT_DIR="$(printf '%s\n' "$LOCATED" | sed -n 1p)"
TASKS="$PROJECT_DIR/.tower/tasks"
TEMPLATE="$PROJECT_DIR/.tower/templates/task-card.md"
[ -r "$TEMPLATE" ] || { echo "tower-new: cannot read $TEMPLATE" >&2; exit 1; }
if [ "$TRACK_SET" -eq 1 ]; then
  export LC_ALL=C
  if ! [[ "$TRACK" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "tower-new: track '$TRACK' must match [a-z0-9][a-z0-9-]*" >&2
    exit 1
  fi
  if [ ! -f "$PROJECT_DIR/.tower/tracks/$TRACK.md" ]; then
    echo "tower-new: track '$TRACK' names no charter in .tower/tracks/" >&2
    exit 1
  fi
  TEMPLATE_TRACK_LINES="$(awk '
    NR == 1 { if ($0 != "---") exit 1; next }
    $0 == "---" { closed = 1; exit }
    /^track:/ { count++ }
    END { if (!closed) exit 1; print count + 0 }
  ' "$TEMPLATE")" || {
    echo "tower-new: $TEMPLATE has no front matter for track:" >&2
    exit 1
  }
  if [ "$TEMPLATE_TRACK_LINES" -gt 1 ]; then
    echo "tower-new: $TEMPLATE has more than one track: line" >&2
    exit 1
  fi
fi
mkdir -p "$TASKS/.claims"

shopt -s nullglob
MAX="$(
  for CARD in "$TASKS"/*.md; do
    basename "$CARD" | sed -nE 's/^T([0-9]+)(-.*)?\.md$/\1/p'
    awk '
      NR == 1 { if ($0 != "---") exit; next }
      /^---$/ { exit }
      /^id: T[0-9]+[[:space:]]*$/ { sub(/^id: T/, ""); print }
    ' "$CARD" || exit 1
  done
  for CLAIM in "$TASKS/.claims"/*; do
    basename "$CLAIM" | sed -nE 's/^T([0-9]+)$/\1/p'
  done
)"
NEXT="$(printf '%s\n' "$MAX" | awk '$1 + 0 > max { max = $1 + 0 } END { printf "%.0f", max + 1 }')"
while true; do
  ID="$(printf 'T%03d' "$NEXT")"
  if ( set -C; : > "$TASKS/.claims/$ID" ) 2>/dev/null; then break; fi
  if [ ! -e "$TASKS/.claims/$ID" ]; then
    echo "tower-new: cannot claim $ID in $TASKS/.claims" >&2
    exit 1
  fi
  NEXT=$((NEXT + 1))
done

SLUG="$(printf '%s' "$TITLE" | LC_ALL=C tr '[:upper:]' '[:lower:]' |
  LC_ALL=C tr -cs 'a-z0-9' '-' | sed 's/^-//; s/-$//' | cut -c 1-50 | sed 's/-$//')"
CARD="$TASKS/$ID-$SLUG.md"
IN_FRONT_MATTER=0
AFTER_DEPENDS_ON=0
TRACK_INSERTED=0
while IFS= read -r LINE || [ -n "$LINE" ]; do
  if [ "$TRACK_SET" -eq 1 ]; then
    if [ "$IN_FRONT_MATTER" -eq 0 ]; then
      IN_FRONT_MATTER=1
    elif [ "$IN_FRONT_MATTER" -eq 1 ]; then
      if [ "$TEMPLATE_TRACK_LINES" -eq 0 ] && [ "$TRACK_INSERTED" -eq 0 ]; then
        if [ "$AFTER_DEPENDS_ON" -eq 1 ]; then
          case "$LINE" in
            '---') printf 'track: %s\n' "$TRACK"; TRACK_INSERTED=1 ;;
            ' '*|'-'*) ;;
            *) printf 'track: %s\n' "$TRACK"; TRACK_INSERTED=1 ;;
          esac
        elif [ "$LINE" = '---' ]; then
          printf 'track: %s\n' "$TRACK"
          TRACK_INSERTED=1
        elif [[ "$LINE" == depends_on:* ]]; then
          AFTER_DEPENDS_ON=1
        fi
      fi
      if [[ "$LINE" == track:* ]]; then
        LINE="track: $TRACK"
      fi
      [ "$LINE" != '---' ] || IN_FRONT_MATTER=2
    fi
  fi
  case "$LINE" in
    'id: T000') printf 'id: %s\n' "$ID" ;;
    title:*) printf 'title: %s\n' "$TITLE" ;;
    *) printf '%s\n' "${LINE//"<task-id>"/$ID}" ;;
  esac
done < "$TEMPLATE" > "$CARD"
if [ "$(git -C "$TASKS" rev-parse --is-inside-work-tree 2>/dev/null)" = true ]; then
  if ! GIT_ERROR="$(git -C "$TASKS" add -- "$CARD" 2>&1)"; then
    printf 'tower-new: created %s but could not stage it: %s\n' "$CARD" "${GIT_ERROR%%$'\n'*}" >&2
  fi
fi
printf '%s\n' "$CARD"
