#!/usr/bin/env bash
set -euo pipefail

TARGET="${1:-$PWD}"
START="$(cd "$TARGET" && pwd)"
PROJECT_DIR="$START"
while [ "$PROJECT_DIR" != "/" ] && [ ! -d "$PROJECT_DIR/.tower" ]; do
  PROJECT_DIR="$(dirname "$PROJECT_DIR")"
done
if [ ! -d "$PROJECT_DIR/.tower" ] && git -C "$START" rev-parse --show-toplevel >/dev/null 2>&1; then
  CUR_TOP="$(git -C "$START" rev-parse --show-toplevel)"
  MAIN_TOP="$(dirname "$(git -C "$START" rev-parse --path-format=absolute --git-common-dir)")"
  if [ "$MAIN_TOP" != "$CUR_TOP" ]; then
    PROJECT_DIR="$MAIN_TOP${START#"$CUR_TOP"}"
    while [ "$PROJECT_DIR" != "$MAIN_TOP" ] && [ ! -d "$PROJECT_DIR/.tower" ]; do
      PROJECT_DIR="$(dirname "$PROJECT_DIR")"
    done
    [ -d "$PROJECT_DIR/.tower" ] && echo "tower-orchestrate: launching in the main checkout ($PROJECT_DIR) - the orchestrator role belongs there, not in a worktree"
  fi
fi
[ -d "$PROJECT_DIR/.tower" ] || { echo "tower-orchestrate: no .tower/ in $TARGET, any ancestor, or the main checkout (run tower-init first)" >&2; exit 1; }

PROMPT="Invoke the tower-orchestrator skill and assume the orchestrator role for this project. Follow the skill fully: run the rehydration ritual including registering your address in .tower/orchestrator, then start the standing loop."

cd "$PROJECT_DIR"
exec claude "$PROMPT"
