#!/usr/bin/env bash
set -euo pipefail

TARGET="${1:-$PWD}"
LOCATE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/tower-locate"

if ! LOCATED="$("$LOCATE" --from "$TARGET")"; then
  echo "tower-orchestrate: no single .tower/ project for $TARGET - run tower-init in the project dir, or pass the project dir as an argument" >&2
  exit 1
fi
PROJECT_DIR="$(printf '%s\n' "$LOCATED" | sed -n 1p)"
case "$(printf '%s\n' "$LOCATED" | sed -n 2p)" in
  worktree|search)
    echo "tower-orchestrate: launching in the main checkout ($PROJECT_DIR) - the orchestrator role belongs there, not in a worktree" ;;
esac

PROMPT="Invoke the tower-orchestrator skill and assume the orchestrator role for this project. Follow the skill fully: run the rehydration ritual including registering your address in .tower/orchestrator, then start the standing loop."

cd "$PROJECT_DIR"
exec claude "$PROMPT"
