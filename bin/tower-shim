#!/usr/bin/env bash
set -uo pipefail

CMD="$(basename "$0")"

is_root() {
  [ -n "${1:-}" ] && [ -x "$1/bin/tower-locate" ] && [ -d "$1/skills/tower-orchestrator" ]
}

from_registry() {
  local home="${HOME:-}" reg path=""
  if [ -z "$home" ]; then printf ''; return 0; fi
  reg="$home/.claude/plugins/installed_plugins.json"
  if [ -r "$reg" ] && command -v jq >/dev/null 2>&1; then
    path="$(jq -r '.plugins["tower@tower"][]?.installPath // empty' "$reg" 2>/dev/null | tail -1)"
  fi
  printf '%s' "$path"
}

from_cache() {
  local home="${HOME:-}" base newest=""
  if [ -z "$home" ]; then return 0; fi
  base="$home/.claude/plugins/cache/tower/tower"
  if [ ! -d "$base" ]; then return 0; fi
  newest="$(cd "$base" && ls -1d */ 2>/dev/null | tr -d / | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)"
  if [ -n "$newest" ]; then printf '%s/%s' "$base" "$newest"; fi
}

from_root_file() {
  local self="$0" dir
  while [ -L "$self" ]; do
    dir="$(cd "$(dirname "$self")" && pwd)" || return 0
    self="$(readlink "$self")"
    case "$self" in
      /*) ;;
      *) self="$dir/$self" ;;
    esac
  done
  dir="$(cd "$(dirname "$self")" && pwd)" || return 0
  if [ -r "$dir/tower-root" ]; then head -1 "$dir/tower-root" 2>/dev/null | tr -d '[:space:]'; fi
}

from_self() {
  local dir
  dir="$(cd "$(dirname "$0")" && pwd)" || return 0
  printf '%s' "$(cd "$dir/.." && pwd)"
}

ROOT=""
for CANDIDATE in "${TOWER_ROOT:-}" "$(from_registry)" "$(from_cache)" "$(from_root_file)" "$(from_self)"; do
  if is_root "$CANDIDATE"; then ROOT="$CANDIDATE"; break; fi
done

if [ -z "$ROOT" ]; then
  echo "tower: cannot resolve the tower install - install the tower plugin, or set TOWER_ROOT to the tower checkout" >&2
  exit 127
fi

TARGET="$ROOT/bin/$CMD"
if [ ! -x "$TARGET" ]; then
  echo "tower: $CMD is not a command in $ROOT/bin" >&2
  exit 127
fi

if [ "$CMD" != "tower-version-check" ] && [ -x "$ROOT/bin/tower-version-check" ]; then
  TOWER_ROOT="$ROOT" "$ROOT/bin/tower-version-check" --notice || true
fi

exec "$TARGET" "$@"
