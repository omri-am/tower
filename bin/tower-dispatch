#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: tower-dispatch <task-id> [--vendor claude|codex] [--headless] [--here] [--prep] [--print-only] [--in-place] [--worktree <path>] [--resume] [--expect-revision <hash>]" >&2
  exit 1
}

TASK_ID="" VENDOR_FLAG="" MODE="terminal" PRINT_ONLY=0 IN_PLACE=0 WT_FLAG="" RESUME=0 EXPECT_REVISION=""
while [ $# -gt 0 ]; do
  case "$1" in
    --vendor) [ $# -ge 2 ] || usage; VENDOR_FLAG="$2"; shift 2 ;;
    --headless) MODE="headless"; shift ;;
    --here) MODE="here"; shift ;;
    --prep) MODE="prep"; shift ;;
    --print-only) PRINT_ONLY=1; shift ;;
    --in-place) IN_PLACE=1; shift ;;
    --worktree) [ $# -ge 2 ] || usage; WT_FLAG="$2"; shift 2 ;;
    --resume) RESUME=1; shift ;;
    --expect-revision) [ $# -ge 2 ] || usage; EXPECT_REVISION="$2"; shift 2 ;;
    -*) usage ;;
    *) [ -n "$TASK_ID" ] && usage; TASK_ID="$1"; shift ;;
  esac
done
[ -n "$TASK_ID" ] || usage
[ "$IN_PLACE" = 0 ] || [ -z "$WT_FLAG" ] || usage
[ "$RESUME" = 0 ] || [ -z "$WT_FLAG" ] || usage

git rev-parse --show-toplevel >/dev/null 2>&1 || { echo "tower-dispatch: not inside a git repository" >&2; exit 1; }

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$BIN_DIR/../lib/tower-dispatch.sh"
. "$BIN_DIR/../lib/tower-paths.sh"
LOCATE="$BIN_DIR/tower-locate"
if ! LOCATED="$("$LOCATE" --task "$TASK_ID")"; then
  echo "tower-dispatch: no single .tower/ project holds $TASK_ID - cd into the project dir, or run tower-init there first" >&2
  exit 1
fi
PROJECT_DIR="$(printf '%s\n' "$LOCATED" | sed -n 1p)"
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd -P)"
if [ -L "$PROJECT_DIR/.tower" ]; then
  PROJECT_DIR="$(dirname "$(cd "$PROJECT_DIR/.tower" && pwd -P)")"
fi
RESOLVED_BY="$(printf '%s\n' "$LOCATED" | sed -n 2p)"

CUR_TOP="$(git rev-parse --show-toplevel)"
ADOPT_WT=""
case "$RESOLVED_BY" in
  worktree|search|ancestor|env)
    case "$PROJECT_DIR/" in "$CUR_TOP/"*) ;; *) ADOPT_WT="$CUR_TOP" ;; esac ;;
esac

CARD="$(resolve_card "$PROJECT_DIR/.tower/tasks" "$TASK_ID")" || exit 1

frontmatter_field() {
  sed -n '/^---$/,/^---$/p' "$1" | sed -n "s/^$2: *//p" | head -1
}

[ "$PRINT_ONLY" = 1 ] || take_dispatch_lock
if [ -n "$EXPECT_REVISION" ]; then
  [ "$(dispatch_revision)" = "$EXPECT_REVISION" ] || dispatch_die 'card or prompt changed; refresh and review before dispatching'
fi
EXPECTED_STATUS=ready
[ "$RESUME" = 0 ] || EXPECTED_STATUS=in-flight
STATUS="$(frontmatter_field "$CARD" status)"
if [ "$STATUS" != "$EXPECTED_STATUS" ]; then
  echo "tower-dispatch: card $TASK_ID has status '$STATUS', expected '$EXPECTED_STATUS' (use --resume only after its previous session has stopped)" >&2
  exit 1
fi

DEPS="$(frontmatter_field "$CARD" depends_on | tr -d '[]' | tr ',' ' ')"
for DEP in $DEPS; do
  DEP_CARD="$(resolve_card "$PROJECT_DIR/.tower/tasks" "$DEP")" || exit 1
  DEP_STATUS="$(frontmatter_field "$DEP_CARD" status)"
  if [ "$DEP_STATUS" != "merged" ]; then
    echo "tower-dispatch: dependency $DEP is '$DEP_STATUS', not 'merged' - refusing to dispatch" >&2
    exit 1
  fi
done
validate_ownership

PROMPT_FILE="$PROJECT_DIR/.tower/prompts/$TASK_ID-prompt.md"
[ -s "$PROMPT_FILE" ] || { echo "tower-dispatch: missing prompt file $PROMPT_FILE (orchestrator finalizes prompts at dispatch)" >&2; exit 1; }

VENDOR="${VENDOR_FLAG:-$(frontmatter_field "$CARD" vendor)}"
if [ -z "$VENDOR" ] || [ "$VENDOR" = "any" ]; then
  VENDOR="claude"
fi
case "$VENDOR" in claude|codex) ;; *) echo "tower-dispatch: unknown vendor '$VENDOR'" >&2; exit 1 ;; esac

SESSION_NAME="$("$BIN_DIR/tower-session-name" --task "$TASK_ID" --from "$PROJECT_DIR")"

TOPLEVEL="$(git -C "$PROJECT_DIR" rev-parse --show-toplevel)"
PROJECT_KEY="projects/${PROJECT_DIR#"$TOPLEVEL"/}"
[ "$PROJECT_DIR" != "$TOPLEVEL" ] || PROJECT_KEY=root
BRANCH="$(frontmatter_field "$CARD" branch | tr -d '"')"
RECORDED_BRANCH="$BRANCH"
BRANCH="${BRANCH:-tower/$PROJECT_KEY/$(basename "$CARD" .md)}"
CREATE_WT=0
if [ "$IN_PLACE" = 1 ]; then
  WORK_DIR="$PROJECT_DIR"
else
  if [ ! -d "$PROJECT_DIR/.tower/.git" ]; then
    echo "tower-dispatch: worktree dispatch requires sidecar mode; use --in-place for this existing project (tower-init --sidecar is for new projects)" >&2
    exit 1
  fi
  if [ "$RESUME" = 1 ]; then
    resume_worktree
  elif [ -n "$WT_FLAG" ]; then
    WT="$(cd "$WT_FLAG" && git rev-parse --show-toplevel)"
  elif [ -n "$ADOPT_WT" ]; then
    WT="$ADOPT_WT"
  else
    WT="$(dirname "$TOPLEVEL")/$(basename "$TOPLEVEL")-tower-worktrees/$PROJECT_KEY/$TASK_ID"
    CREATE_WT=1
  fi
  WORK_DIR="$WT${PROJECT_DIR#"$TOPLEVEL"}"
  if [ "$CREATE_WT" = 0 ]; then
    WT="$(cd "$WT" && pwd -P)"
    WORK_DIR="$WT${PROJECT_DIR#"$TOPLEVEL"}"
    validate_worktree
  fi
fi

prepare_launch "$SESSION_NAME"
LAUNCH="$(launch_command)"

if [ "$PRINT_ONLY" = 1 ]; then
  echo "$LAUNCH"
  exit 0
fi

if [ "$IN_PLACE" = 1 ]; then
  if [ "$RESUME" = 1 ]; then
    [ "$(git -C "$TOPLEVEL" branch --show-current)" = "$RECORDED_BRANCH" ] || dispatch_die 'checkout is no longer on the recorded task branch'
  else
    prepare_in_place
  fi
else
  if [ "$CREATE_WT" = 1 ]; then
    git -C "$TOPLEVEL" worktree add -q -b "$BRANCH" "$WT"
  fi
  mkdir -p "$WORK_DIR"
  [ -e "$WORK_DIR/.tower" ] || ln -s "$PROJECT_DIR/.tower" "$WORK_DIR/.tower"
  echo "$TASK_ID" > "$WORK_DIR/.tower-task"
fi

if [ "$RESUME" = 0 ]; then
  write_dispatch_card
fi
commit_dispatch_card
release_dispatch_lock

if [ "$MODE" = "prep" ]; then
  echo "tower-dispatch: prepared $TASK_ID in $WORK_DIR (branch $BRANCH, card in-flight)"
  echo "start your agent there and tell it: read .tower/prompts/$TASK_ID-prompt.md and execute it as your task"
elif [ "$MODE" = "headless" ] || [ "$MODE" = "here" ]; then
  launch_here || { RESULT=$?; echo "tower-dispatch: session exited $RESULT; after confirming it has stopped, use --resume to reuse its worktree" >&2; exit "$RESULT"; }
else
  ESCAPED="${LAUNCH//\\/\\\\}"
  ESCAPED="${ESCAPED//\"/\\\"}"
  osascript -e "tell application \"Terminal\" to do script \"$ESCAPED\"" -e 'tell application "Terminal" to activate' >/dev/null
  echo "tower-dispatch: launched $VENDOR for $TASK_ID in a new Terminal window (branch $BRANCH)"
fi
