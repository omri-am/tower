#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: tower-dispatch <task-id> [--vendor claude|codex] [--headless] [--print-only]" >&2
  exit 1
}

TASK_ID="" VENDOR_FLAG="" MODE="terminal" PRINT_ONLY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --vendor) [ $# -ge 2 ] || usage; VENDOR_FLAG="$2"; shift 2 ;;
    --headless) MODE="headless"; shift ;;
    --print-only) PRINT_ONLY=1; shift ;;
    -*) usage ;;
    *) [ -n "$TASK_ID" ] && usage; TASK_ID="$1"; shift ;;
  esac
done
[ -n "$TASK_ID" ] || usage

REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "tower-dispatch: not inside a git repository" >&2; exit 1; }
[ -d "$REPO/.tower" ] || { echo "tower-dispatch: no .tower/ in $REPO (run tower-init first)" >&2; exit 1; }

CARD="$(find "$REPO/.tower/tasks" -name "$TASK_ID-*.md" -o -name "$TASK_ID.md" | head -1)"
[ -n "$CARD" ] || { echo "tower-dispatch: no card for $TASK_ID in .tower/tasks/" >&2; exit 1; }

frontmatter_field() {
  sed -n '/^---$/,/^---$/p' "$1" | sed -n "s/^$2: *//p" | head -1
}

STATUS="$(frontmatter_field "$CARD" status)"
if [ "$STATUS" != "ready" ]; then
  echo "tower-dispatch: card $TASK_ID has status '$STATUS', expected 'ready'" >&2
  exit 1
fi

DEPS="$(frontmatter_field "$CARD" depends_on | tr -d '[]' | tr ',' ' ')"
for DEP in $DEPS; do
  DEP_CARD="$(find "$REPO/.tower/tasks" -name "$DEP-*.md" -o -name "$DEP.md" | head -1)"
  [ -n "$DEP_CARD" ] || { echo "tower-dispatch: dependency $DEP has no card" >&2; exit 1; }
  DEP_STATUS="$(frontmatter_field "$DEP_CARD" status)"
  if [ "$DEP_STATUS" != "merged" ]; then
    echo "tower-dispatch: dependency $DEP is '$DEP_STATUS', not 'merged' - refusing to dispatch" >&2
    exit 1
  fi
done

PROMPT_FILE="$REPO/.tower/prompts/$TASK_ID-prompt.md"
[ -s "$PROMPT_FILE" ] || { echo "tower-dispatch: missing prompt file $PROMPT_FILE (orchestrator finalizes prompts at dispatch)" >&2; exit 1; }

VENDOR="${VENDOR_FLAG:-$(frontmatter_field "$CARD" vendor)}"
if [ -z "$VENDOR" ] || [ "$VENDOR" = "any" ]; then
  VENDOR="claude"
fi
case "$VENDOR" in claude|codex) ;; *) echo "tower-dispatch: unknown vendor '$VENDOR'" >&2; exit 1 ;; esac

BRANCH="tower/$(basename "$CARD" .md)"

case "$VENDOR" in
  claude)
    if [ "$MODE" = "headless" ]; then
      LAUNCH="cd '$REPO' && TOWER_TASK=$TASK_ID claude -p \"\$(cat '$PROMPT_FILE')\""
    else
      LAUNCH="cd '$REPO' && TOWER_TASK=$TASK_ID claude \"\$(cat '$PROMPT_FILE')\""
    fi
    ;;
  codex)
    if [ "$MODE" = "headless" ]; then
      LAUNCH="cd '$REPO' && TOWER_TASK=$TASK_ID codex exec \"\$(cat '$PROMPT_FILE')\""
    else
      LAUNCH="cd '$REPO' && TOWER_TASK=$TASK_ID codex \"\$(cat '$PROMPT_FILE')\""
    fi
    ;;
esac

if [ "$PRINT_ONLY" = 1 ]; then
  echo "$LAUNCH"
  exit 0
fi

sed -i '' "s|^status: ready|status: in-flight|" "$CARD"
sed -i '' "s|^branch: \"\"|branch: \"$BRANCH\"|" "$CARD"
if [ -d "$REPO/.tower/.git" ]; then
  git -C "$REPO/.tower" add "tasks/$(basename "$CARD")"
  git -C "$REPO/.tower" commit -q -m "tower: dispatch $TASK_ID"
else
  git -C "$REPO" add "$CARD"
  git -C "$REPO" commit -q -m "tower: dispatch $TASK_ID"
fi

if [ "$MODE" = "headless" ]; then
  eval "$LAUNCH"
else
  ESCAPED="${LAUNCH//\\/\\\\}"
  ESCAPED="${ESCAPED//\"/\\\"}"
  osascript -e "tell application \"Terminal\" to do script \"$ESCAPED\"" -e 'tell application "Terminal" to activate' >/dev/null
  echo "tower-dispatch: launched $VENDOR for $TASK_ID in a new Terminal window (branch $BRANCH)"
fi
