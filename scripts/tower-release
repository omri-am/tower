#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$ROOT/lib/tower-semver.sh"
. "$ROOT/lib/tower-meta.sh"

die() { echo "tower-release: $1" >&2; exit 1; }

usage() { die "usage: tower-release <x.y.z> | tower-release --tag <x.y.z>"; }

collect_index_fragments() {
  local fragments="$1" output="$2" fragment
  while IFS= read -r fragment; do
    [ -n "$fragment" ] || continue
    awk '
      !/^[[:space:]]*$/ { if (!first) first=NR; last=NR }
      { lines[NR]=$0 }
      END {
        if (!first) exit
        if (lines[first] !~ /^## /) exit 1
        for (i=first; i<=last; i++) print lines[i]
        print ""
      }
    ' "$ROOT/$fragment" >> "$output" || die "$fragment must start with a '## ' heading"
  done <<EOF
$fragments
EOF
}

check_index_anchor() {
  local document="$1" anchor="$2" content="$3" count
  [ -s "$content" ] || return 0
  [ -f "$ROOT/$document" ] || die "$document must contain '$anchor' exactly once"
  count="$(grep -cxF "$anchor" "$ROOT/$document" || true)"
  [ "$count" -eq 1 ] || die "$document must contain '$anchor' exactly once"
}

fold_index() {
  local document="$1" anchor="$2" content="$3"
  [ -s "$content" ] || return 0
  TMP="$(mktemp)"
  awk -v anchor="$anchor" -v fragments="$content" '
    $0 == anchor {
      while ((getline line < fragments) > 0) print line
      close(fragments)
    }
    { print }
  ' "$ROOT/$document" > "$TMP"
  mv "$TMP" "$ROOT/$document"
}

if [ "${1:-}" = "--tag" ]; then
  MODE="tag"
  [ $# -eq 2 ] || usage
  NEW="$2"
else
  MODE="prepare"
  [ $# -eq 1 ] || usage
  NEW="$1"
fi

case "$NEW" in
  [0-9]*.[0-9]*.[0-9]*) : ;;
  *) die "$NEW is not an x.y.z version" ;;
esac
case "$NEW" in *[!0-9.]*) die "$NEW is not an x.y.z version" ;; esac

MANIFEST="$ROOT/.claude-plugin/plugin.json"
CHANGELOG="$ROOT/CHANGELOG.md"

if [ "$MODE" = "tag" ]; then

  git -C "$ROOT" diff --quiet || die "working tree has unstaged changes"
  git -C "$ROOT" diff --cached --quiet || die "working tree has staged changes"

  BRANCH="$(git -C "$ROOT" symbolic-ref --short -q HEAD || true)"
  [ "$BRANCH" = "main" ] || die "current branch is ${BRANCH:-detached HEAD}, not main"

  git -C "$ROOT" fetch origin -q || die "could not fetch origin"
  LOCAL_MAIN="$(git -C "$ROOT" rev-parse main 2>/dev/null)" || die "cannot resolve local main"
  REMOTE_MAIN="$(git -C "$ROOT" rev-parse origin/main 2>/dev/null)" || die "cannot resolve origin/main - has main ever been pushed to origin?"
  [ "$LOCAL_MAIN" = "$REMOTE_MAIN" ] || die "local main does not match origin/main"

  [ -r "$MANIFEST" ] || die "no manifest at $MANIFEST"
  CURRENT="$(tower_version "$ROOT")"
  [ "$CURRENT" = "$NEW" ] || die "manifest reads $CURRENT, not $NEW"

  if git -C "$ROOT" rev-parse -q --verify "refs/tags/v$NEW" >/dev/null; then
    die "tag v$NEW already exists"
  fi

  git -C "$ROOT" tag "v$NEW"

  echo "tower-release: v$NEW tagged on main"
  echo "tower-release: review, then run -> git push origin v$NEW"

else

  [ -r "$MANIFEST" ] || die "no manifest at $MANIFEST"
  [ -r "$CHANGELOG" ] || die "no changelog at $CHANGELOG"

  CURRENT="$(tower_version "$ROOT")"
  [ -n "$CURRENT" ] || die "cannot read the current version from $MANIFEST"
  semver_gt "$NEW" "$CURRENT" || die "$NEW is not newer than the current $CURRENT"

  git -C "$ROOT" diff --quiet || die "working tree has unstaged changes"
  git -C "$ROOT" diff --cached --quiet || die "working tree has staged changes"
  if git -C "$ROOT" rev-parse -q --verify "refs/tags/v$NEW" >/dev/null; then
    die "tag v$NEW already exists"
  fi
  if git -C "$ROOT" rev-parse -q --verify "refs/heads/release-v$NEW" >/dev/null; then
    die "branch release-v$NEW already exists"
  fi

  UNRELEASED_HEADINGS="$(grep -c '^## Unreleased$' "$CHANGELOG" || true)"
  [ "$UNRELEASED_HEADINGS" -eq 1 ] || die "CHANGELOG.md has $UNRELEASED_HEADINGS '## Unreleased' headings, expected exactly 1"

  UNRELEASED="$(awk '/^## Unreleased$/{f=1;next} /^## /{f=0} f' "$CHANGELOG" | tr -d '[:space:]')"
  FRAGMENTS="$(git -C "$ROOT" ls-files -- 'changelog.d/*.md')"
  PROTOCOL_FRAGMENTS="$(git -C "$ROOT" ls-files -- 'protocol.d/*.md')"
  REFERENCE_FRAGMENTS="$(git -C "$ROOT" ls-files -- 'reference.d/*.md')"
  TMP=""
  TMP_FRAGMENTS="$(mktemp)"
  TMP_PROTOCOL="$(mktemp)"
  TMP_REFERENCE="$(mktemp)"
  trap 'rm -f "$TMP_FRAGMENTS" "$TMP_PROTOCOL" "$TMP_REFERENCE" "$TMP"' EXIT
  while IFS= read -r fragment; do
    [ -n "$fragment" ] || continue
    awk '{ lines[NR]=$0; if (NF) last=NR } END { for (i=1; i<=last; i++) print lines[i]; if (last) print "" }' "$ROOT/$fragment" >> "$TMP_FRAGMENTS"
  done <<EOF
$FRAGMENTS
EOF
  collect_index_fragments "$PROTOCOL_FRAGMENTS" "$TMP_PROTOCOL"
  collect_index_fragments "$REFERENCE_FRAGMENTS" "$TMP_REFERENCE"
  check_index_anchor "PROTOCOL.md" "## Protocol version" "$TMP_PROTOCOL"
  check_index_anchor "docs/REFERENCE.md" "## Core ideas" "$TMP_REFERENCE"
  FRAGMENT_CONTENT="$(tr -d '[:space:]' < "$TMP_FRAGMENTS")"
  [ -n "$UNRELEASED$FRAGMENT_CONTENT" ] || [ -s "$TMP_PROTOCOL" ] || [ -s "$TMP_REFERENCE" ] ||
    die "CHANGELOG.md has nothing under '## Unreleased' and no changelog.d/, protocol.d/ or reference.d/ fragment has an entry - a version bump with no entry tells nobody what shipped"

  TODAY="$(date +%Y-%m-%d)"
  TMP="$(mktemp)"

  awk -v cur="$CURRENT" -v new="$NEW" '
    BEGIN {
      n = split(cur, parts, ".")
      escaped = parts[1]
      for (i = 2; i <= n; i++) escaped = escaped "\\." parts[i]
      re = "^[[:space:]]*\"version\"[[:space:]]*:[[:space:]]*\"" escaped "\""
    }
    !done && match($0, re) {
      full_end = RSTART + RLENGTH
      match($0, /^[[:space:]]*/)
      indent = substr($0, 1, RLENGTH)
      suffix = substr($0, full_end)
      print indent "\"version\": \"" new "\"" suffix
      done = 1
      next
    }
    { print }
  ' "$MANIFEST" > "$TMP"
  mv "$TMP" "$MANIFEST"

  VERIFY="$(tower_version "$ROOT")"
  [ "$VERIFY" = "$NEW" ] || die "manifest rewrite did not take - $MANIFEST still does not read $NEW"

  TMP="$(mktemp)"
  awk -v new="## v$NEW — $TODAY" -v fragments="$TMP_FRAGMENTS" '
    function print_version_entries(    i, line) {
      while (n && lines[n] ~ /^[[:space:]]*$/) n--
      for (i=1; i<=n; i++) print lines[i]
      print ""
      while ((getline line < fragments) > 0) print line
      close(fragments)
    }
    /^## Unreleased$/ && !done { print "## Unreleased"; print ""; print new; done=1; collecting=1; next }
    /^## / && collecting { print_version_entries(); collecting=0 }
    collecting { lines[++n]=$0; next }
    { print }
    END { if (collecting) print_version_entries() }
  ' "$CHANGELOG" > "$TMP"
  mv "$TMP" "$CHANGELOG"

  # Unreleased fragments can disagree; read and reconcile the assembled text before tagging.
  fold_index "PROTOCOL.md" "## Protocol version" "$TMP_PROTOCOL"
  fold_index "docs/REFERENCE.md" "## Core ideas" "$TMP_REFERENCE"

  git -C "$ROOT" checkout -q -b "release-v$NEW"
  git -C "$ROOT" add "$MANIFEST" "$CHANGELOG"
  [ ! -s "$TMP_PROTOCOL" ] || git -C "$ROOT" add -- PROTOCOL.md
  [ ! -s "$TMP_REFERENCE" ] || git -C "$ROOT" add -- docs/REFERENCE.md
  [ -z "$FRAGMENTS" ] || git -C "$ROOT" rm -q -- 'changelog.d/*.md'
  [ -z "$PROTOCOL_FRAGMENTS" ] || git -C "$ROOT" rm -q -- 'protocol.d/*.md'
  [ -z "$REFERENCE_FRAGMENTS" ] || git -C "$ROOT" rm -q -- 'reference.d/*.md'
  git -C "$ROOT" commit -q -m "Release v$NEW"

  echo "tower-release: v$NEW committed on release-v$NEW"
  FOLDED_DOCUMENTS=""
  [ ! -s "$TMP_PROTOCOL" ] || FOLDED_DOCUMENTS="PROTOCOL.md"
  [ ! -s "$TMP_REFERENCE" ] || FOLDED_DOCUMENTS="${FOLDED_DOCUMENTS:+$FOLDED_DOCUMENTS and }docs/REFERENCE.md"
  [ -z "$FOLDED_DOCUMENTS" ] || echo "tower-release: read the folded $FOLDED_DOCUMENTS text before tagging, and rewrite it where two fragments disagree"
  echo "tower-release: run -> git push -u origin release-v$NEW"
  echo "tower-release: open a pull request, merge it, then run -> tower-release --tag $NEW"

fi
